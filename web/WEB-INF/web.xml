<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <!-- El filtro de errores va primero para capturar fallos de cualquier capa. -->
    <filter>
        <filter-name>FiltroErrores</filter-name>
        <filter-class>filtros.FiltroErrores</filter-class>
    </filter>
    <filter>
        <filter-name>FiltroSesion</filter-name>
        <filter-class>filtros.FiltroSesion</filter-class>
    </filter>
    <filter>
        <filter-name>FiltroAsistente</filter-name>
        <filter-class>filtros.FiltroAsistente</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>FiltroErrores</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>FiltroSesion</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>FiltroAsistente</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>ControladorUsuario</servlet-name>
        <servlet-class>controlador.ControladorUsuario</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EditarUsuario</servlet-name>
        <servlet-class>controlador.EditarUsuario</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EliminarUsuario</servlet-name>
        <servlet-class>controlador.EliminarUsuario</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolValidar</servlet-name>
        <servlet-class>controlador.CtrolValidar</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CerrarSesion</servlet-name>
        <servlet-class>controlador.CerrarSesion</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolActividades</servlet-name>
        <servlet-class>controlador.CtrolActividades</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolGesActividad</servlet-name>
        <servlet-class>controlador.CtrolGesActividad</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolPerfil</servlet-name>
        <servlet-class>controlador.CtrolPerfil</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CambiarPerfil</servlet-name>
        <servlet-class>controlador.CambiarPerfil</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolPaciente</servlet-name>
        <servlet-class>controlador.CtrolPaciente</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolCama</servlet-name>
        <servlet-class>controlador.CtrolCama</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolEspecialidad</servlet-name>
        <servlet-class>controlador.CtrolEspecialidad</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolInventario</servlet-name>
        <servlet-class>controlador.CtrolInventario</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolMedicamento</servlet-name>
        <servlet-class>controlador.CtrolMedicamento</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolMedico</servlet-name>
        <servlet-class>controlador.CtrolMedico</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolHospitalizacion</servlet-name>
        <servlet-class>controlador.CtrolHospitalizacion</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolHistoriaClinica</servlet-name>
        <servlet-class>controlador.CtrolHistoriaClinica</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolDiagnostico</servlet-name>
        <servlet-class>controlador.CtrolDiagnostico</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CtrolTratamiento</servlet-name>
        <servlet-class>controlador.CtrolTratamiento</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ControladorUsuario</servlet-name>
        <url-pattern>/ControladorUsuario</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>EditarUsuario</servlet-name>
        <url-pattern>/EditarUsuario</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>EliminarUsuario</servlet-name>
        <url-pattern>/EliminarUsuario</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolValidar</servlet-name>
        <url-pattern>/CtrolValidar</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CerrarSesion</servlet-name>
        <url-pattern>/CerrarSesion</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolActividades</servlet-name>
        <url-pattern>/CtrolActividades</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolGesActividad</servlet-name>
        <url-pattern>/CtrolGesActividad</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolPerfil</servlet-name>
        <url-pattern>/CtrolPerfil</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CambiarPerfil</servlet-name>
        <url-pattern>/CambiarPerfil</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolPaciente</servlet-name>
        <url-pattern>/CtrolPaciente</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolCama</servlet-name>
        <url-pattern>/CtrolCama</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolEspecialidad</servlet-name>
        <url-pattern>/CtrolEspecialidad</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolInventario</servlet-name>
        <url-pattern>/CtrolInventario</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolMedicamento</servlet-name>
        <url-pattern>/CtrolMedicamento</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolMedico</servlet-name>
        <url-pattern>/CtrolMedico</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolHospitalizacion</servlet-name>
        <url-pattern>/CtrolHospitalizacion</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolHistoriaClinica</servlet-name>
        <url-pattern>/CtrolHistoriaClinica</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolDiagnostico</servlet-name>
        <url-pattern>/CtrolDiagnostico</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CtrolTratamiento</servlet-name>
        <url-pattern>/CtrolTratamiento</url-pattern>
    </servlet-mapping>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <session-config>
        <!-- Respaldo: el valor real se controla desde la pantalla Configuracion
             (tabla configuracion) y lo aplica FiltroSesion en cada peticion. -->
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- La cookie no viaja en peticiones originadas desde otros sitios (anti-CSRF).
                 Si publicas con HTTPS agrega aqui:  <secure>true</secure> -->
            <attribute>
                <attribute-name>SameSite</attribute-name>
                <attribute-value>Strict</attribute-value>
            </attribute>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
</web-app>