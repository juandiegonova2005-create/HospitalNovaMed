# Copia este archivo como .env y ajusta lo que necesites.
# docker-compose.yml usa estos valores; si no existe .env, aplica los default.

# Puerto del navegador (8081 para no chocar con el Tomcat local en 8080)
NOVAMED_HTTP_PORT=8081

# Puerto para conectarse a MySQL desde el host (3307 para no chocar con el local)
NOVAMED_DB_PORT=3307

# Base de datos y usuario de la aplicacion
NOVAMED_DB_NAME=HospitalDB
NOVAMED_DB_USER=novamed
NOVAMED_DB_PASS=NovaMed#2026

# Clave del root de MySQL (solo uso administrativo dentro del contenedor)
MYSQL_ROOT_PASSWORD=novamed_root_2026

# Correo para "Olvide mi contrasena" (SMTP).
# Si NOVAMED_SMTP_HOST queda vacio, el enlace se escribe en novamed-error.log.
# En Gmail: activa la verificacion en dos pasos y crea una "clave de aplicacion".
NOVAMED_SMTP_HOST=smtp.gmail.com
NOVAMED_SMTP_PORT=587
NOVAMED_SMTP_USER=tucorreo@gmail.com
NOVAMED_SMTP_PASS=clave-de-aplicacion
NOVAMED_SMTP_FROM=tucorreo@gmail.com
NOVAMED_SMTP_SSL=false
